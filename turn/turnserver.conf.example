# coturn configuration for Quick Hellou
# New installation: copy to /etc/turnserver.conf, replace every <...> value, then:
#   systemctl restart coturn && systemctl status coturn
# Existing, working installation: do NOT replace your file - only add the relay
# protection settings, as described in docs/turn.md.
#
# Security goals:
#   * the relay can never be used to reach this server's own private services
#     (Redis 127.0.0.1:6380, Postgres :5435, pgAdmin :5050, Docker networks)
#   * the relay cannot be used as a TCP proxy to scan/attack other hosts

# --- network ---------------------------------------------------------------
listening-port=3478
# TLS listener (turns:) - enable together with cert/pkey below if you use it
#tls-listening-port=5349
listening-ip=<SERVER_PUBLIC_IP>
external-ip=<SERVER_PUBLIC_IP>
relay-ip=<SERVER_PUBLIC_IP>

# Relay ports. Open exactly this UDP range in the firewall (see docs/server-hardening.md).
# 1000 ports = up to ~1000 simultaneous relayed media streams.
min-port=49152
max-port=50151

# --- authentication ------------------------------------------------------
# Static login handed to browsers by the app: TURN_SERVER_USERNAME is used as
# both username and password (ICE_SERVER_OVERRIDE in qhv2/settings.py).
lt-cred-mech
user=<TURN_SERVER_USERNAME>:<TURN_SERVER_USERNAME>
realm=<your-domain e.g. qhellou.com>
fingerprint
stale-nonce=600

# --- abuse limits ----------------------------------------------------------
# Max simultaneous allocations in total. No user-quota: all visitors share the
# one static login, so a per-user quota would cap everyone together.
total-quota=1200
# Max bytes per second per session (0 = unlimited). ~4 Mbit/s is plenty for 720p.
max-bps=500000

# WebRTC only needs UDP relaying. Disabling TCP relay (RFC 6062) stops the
# server from being used as a TCP proxy (e.g. to port-scan or attack others).
no-tcp-relay
no-multicast-peers

# --- forbidden relay destinations (peers) ---------------------------------
# Loopback, private, link-local, CGNAT, multicast, reserved ranges
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
# Docker networks used by this project (docker-compose subnets)
denied-peer-ip=192.170.0.0-192.170.0.255
denied-peer-ip=192.180.0.0-192.180.0.255
# IPv6: loopback, IPv4-mapped (bypass trick), unique-local, link-local, multicast
denied-peer-ip=::1
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Do NOT deny the server's own public IP: calls where both sides use TURN relay
# to each other through that address.

# --- hardening -------------------------------------------------------------
no-cli
no-tlsv1
no-tlsv1_1
no-software-attribute
#cert=/etc/letsencrypt/live/<domain>/fullchain.pem
#pkey=/etc/letsencrypt/live/<domain>/privkey.pem

# --- logging ---------------------------------------------------------------
log-file=/var/log/turnserver/turnserver.log
simple-log
